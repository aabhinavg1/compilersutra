pipeline {
  agent any
  options {
    disableConcurrentBuilds()
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '40'))
  }
  // Manual / nightly discovery only — read-only, no site mutation.
  triggers {
    cron('H 6 * * *')
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }
    stage('Analyze LLVM curriculum') {
      steps {
        sh '''
          set -euo pipefail
          python3 --version
          python3 scripts/llvm-curriculum-bot/analyze_curriculum.py
          echo "---- backlog head ----"
          head -n 40 scripts/llvm-curriculum-bot/out/curriculum-backlog.md
          echo "---- next article ----"
          cat scripts/llvm-curriculum-bot/out/next-article.json
        '''
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'scripts/llvm-curriculum-bot/out/*', fingerprint: true, allowEmptyArchive: true
    }
    failure {
      echo 'llvm curriculum analyzer failed; see logs and archived out/ if any.'
    }
  }
}
